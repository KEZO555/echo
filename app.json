{
  "expo": {
    "name": "Tide",
    "slug": "tide",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "tide",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "android": {
      "backgroundColor": "#000000",
      "package": "com.kezo.tide",
      "permissions": ["android.permission.WRITE_SECURE_SETTINGS"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Tide to access your photos.",
          "savePhotosPermission": "Allow Tide to save photos.",
          "granularPermissions": ["photo"]
        }
      ],
      "./plugins/with-android-config-changes",
      "./plugins/with-tidal-auth-manifest-placeholders",
      "./plugins/with-android-theme",
      "./plugins/with-daltonizer-toggle"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
